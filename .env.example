# Tethyr — environment variable reference
#
# Copy this file to `.env` and fill in the values you need, or rely on the
# auto-generated runtime config described below. No secrets are required for
# local development — Supabase runs locally and its keys are generated per
# instance.

# ── Supabase (local, auto-generated) ────────────────────────────────────────
# Local developoment starts the full Supabase stack AND writes these to
# .env.supabase-runtime (gitignored) via:
#
#     bash scripts/base44-start.sh
#
# .env.supabase-runtime is loaded at dev/build time and contains:
#   SUPABASE_URL                  (SSR side, host gateway)
#   SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   VITE_SUPABASE_URL             (browser side, public port proxy)
#   VITE_SUPABASE_PUBLISHABLE_KEY
#
# Do not hand-edit .env.supabase-runtime — it is regenerated on every start.
# Hosted/remote deployments supply the Supabase project keys through the
# platform instead.

# ── App configuration (optional, per environment) ───────────────────────────
# Absolute URL used for canonical URLs, sitemaps, and share links.
# When unset the server derives it from the request.
VITE_PUBLIC_SITE_URL=

# Sentry DSN for the browser error reporter. Leave empty to disable Sentry.
VITE_SENTRY_DSN=

# ── Bundle-size tripwire budgets (optional) ─────────────────────────────────
# Only read by scripts/check-bundle-size.mjs after `npm run build`.
# Units are bytes.
# BUNDLE_MAX_RAW=800000
# BUNDLE_MAX_GZIP=210000
# BUNDLE_CLIENT_MAX_RAW=900000
# BUNDLE_CLIENT_MAX_GZIP=280000
# BUNDLE_SERVER_MAX_RAW=800000
# BUNDLE_SERVER_MAX_GZIP=210000